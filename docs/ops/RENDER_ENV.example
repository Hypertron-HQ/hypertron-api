# Paste into Render → hypertron-api → Environment → Add from .env
# Redis is disabled. Later: DISABLE_REDIS=false + real REDIS_URL + THROTTLE_STORAGE=redis

NODE_ENV=production
APP_URL=https://hypertron-api.onrender.com
CHECKOUT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=REPLACE_MONGODB_URL_HYPERTRON_API

DISABLE_REDIS=true
DISABLE_WORKERS=true
THROTTLE_STORAGE=memory
REDIS_URL=redis://127.0.0.1:6379

AUTH_SECRET=REPLACE_SHARED_AUTH_SECRET
INTERNAL_SERVICE_TOKEN=REPLACE_SHARED_INTERNAL_SERVICE_TOKEN

CORE_BACKEND_URL=https://hypertron-core-backend.onrender.com
CORE_BACKEND_SERVICE_ACCOUNT_API_KEY=REPLACE_CORE_SERVICE_ACCOUNT_API_KEY
CORE_BACKEND_TIMEOUT_MS=8000

WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_64_CHAR_HEX

SWAGGER_ENABLED=false
OTEL_SDK_DISABLED=true
API_KEY_SALT_ROUNDS=12

RATE_LIMIT_PAYMENT_CREATE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_DASHBOARD_PER_MIN=120

STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
PAYMENT_POOL_ADDRESS=REPLACE_POOL_C_ADDRESS
STELLAR_TESTNET_DESTINATION_ADDRESS=REPLACE_CLASSIC_G_ADDRESS
STELLAR_MAINNET_DESTINATION_ADDRESS=
STELLAR_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3MNLQUIL
STELLAR_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_EURC_ISSUER_MAINNET=GDHU6WRTMTRRCAXVSNHHSZKWNTAPDS75BOZPAV5P5W7QIT4QGC4O2NGS
STELLAR_FINALITY_DELAY_MS=5000
STELLAR_RECONCILER_LOOKBACK=50
