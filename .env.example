# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=https://api.hypertron.xyz
CHECKOUT_BASE_URL=https://pay.hypertron.xyz

# Set to "true" to expose Swagger UI at /docs (disable in production)
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Database (MongoDB) — api_svc user (NOT shared admin)
# Own DB `hypertron_api` on the same Atlas cluster (no shared collections with core).
# See ../scripts/atlas-mongo-users.md and ../scripts/migrate-api-db.js
# ─────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://api_svc:<password>@<cluster>.mongodb.net/hypertron_api?retryWrites=true&w=majority

# Shared with hypertron-core-backend for MerchantSettings push (A4)
INTERNAL_SERVICE_TOKEN=replace-with-long-random-token
# Base URL core uses when calling this API (core-side env); documented here for ops
# PAYMENTS_API_URL=http://localhost:4001

# ─────────────────────────────────────────────────────────────
# Redis (BullMQ queues + rate limiting)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Set true on HTTP-only pods (skip BullMQ workers / cron schedulers)
DISABLE_WORKERS=false

# ─────────────────────────────────────────────────────────────
# Stellar (public addresses only — no custody secrets)
# ─────────────────────────────────────────────────────────────
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
# Private settlement pool (C…) — NOT used as classic checkout destination
PAYMENT_POOL_ADDRESS=CB2SVTMGQKQVLUHWC5J7K5NOHPXULWEJL452B457NCRW7OKJ42XSVOLL
# Classic fallback G… destinations when Business.receiveAddress is unset
STELLAR_TESTNET_DESTINATION_ADDRESS=
STELLAR_MAINNET_DESTINATION_ADDRESS=
# Asset issuers for reconciler verification (defaults = Circle well-known)
STELLAR_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3MNLQUIL
STELLAR_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_EURC_ISSUER_TESTNET=
STELLAR_EURC_ISSUER_MAINNET=GDHU6WRTMTRRCAXVSNHHSZKWNTAPDS75BOZPAV5P5W7QIT4QGC4O2NGS
# Finality delay before pending→confirmed→completed (ms)
STELLAR_FINALITY_DELAY_MS=5000
STELLAR_RECONCILER_LOOKBACK=50

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# Must match hypertron-core-backend AUTH_SECRET (Freighter ht_dashboard cookies)
AUTH_SECRET=replace-with-a-long-random-secret

# bcrypt rounds for API key hashing (12 = ~250ms, good for production)
API_KEY_SALT_ROUNDS=12

# 32-byte hex key for AES-256-GCM webhook secret encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=<32-byte-hex>

# Allowed CORS origins (comma-separated) — dashboard origin for cookie auth
CORS_ORIGINS=https://app.hypertron.xyz,https://pay.hypertron.xyz,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PAYMENT_CREATE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_DASHBOARD_PER_MIN=120
