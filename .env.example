# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=https://api.hypertron.xyz
CHECKOUT_BASE_URL=https://pay.hypertron.xyz

# Set to "true" to expose Swagger UI at /docs (disable in production)
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Database (MongoDB) — same DB as hypertron-core-backend
# ─────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hypertron?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
# Redis (BullMQ queues + rate limiting)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# Stellar (public addresses only — no custody secrets)
# ─────────────────────────────────────────────────────────────
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
PAYMENT_POOL_ADDRESS=CBNJY2ULVHOSHCTA4ZBMCU7AEVZHK4J5D3UEWIRSUYTIAQXZNTYQAMJQ
STELLAR_TESTNET_DESTINATION_ADDRESS=
STELLAR_MAINNET_DESTINATION_ADDRESS=

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# Must match hypertron-core-backend AUTH_SECRET (Freighter ht_dashboard cookies)
AUTH_SECRET=replace-with-a-long-random-secret

# bcrypt rounds for API key hashing (12 = ~250ms, good for production)
API_KEY_SALT_ROUNDS=12

# 32-byte hex key for AES-256-GCM webhook secret encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=<32-byte-hex>

# Allowed CORS origins (comma-separated) — dashboard origin for cookie auth
CORS_ORIGINS=https://app.hypertron.xyz,https://pay.hypertron.xyz,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PAYMENT_CREATE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_DASHBOARD_PER_MIN=120
