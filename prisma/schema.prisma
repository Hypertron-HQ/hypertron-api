// Hypertron Payments API — Prisma Schema (MongoDB)
// Shares the `hypertron` database with hypertron-core-backend.
// businessId is always a core Business.id cuid string (never ObjectId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Environment {
  test
  live
}

enum PaymentStatus {
  created
  pending
  confirmed
  completed
  failed
  expired
  canceled
}

enum PaymentCurrency {
  USDC
  EURC
  XLM
}

enum DeliveryStatus {
  pending
  delivered
  failed
}

// ─────────────────────────────────────────────────────────────────────────────
// Core-shared read/write models (same collections as hypertron-core-backend)
// ─────────────────────────────────────────────────────────────────────────────

model Business {
  id             String    @id @default(cuid()) @map("_id")
  walletAddress  String    @unique
  receiveAddress String?
  name           String?
  email          String?
  createdAt      DateTime  @default(now())

  paymentLinks PaymentLink[]

  @@map("Business")
}

model PaymentLink {
  id                 String    @id @default(cuid()) @map("_id")
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount             String?
  currency           String    @default("USDC")
  purpose            String?
  clientName         String?
  workflowStage      String?
  metadata           String?
  paymentMethods     String[]  @default(["wallet", "qr"])
  expiresAt          DateTime?
  linkMemo           String    @unique
  destinationAddress String
  paidAt             DateTime?
  paymentTxHash      String?
  createdAt          DateTime  @default(now())

  @@index(businessId)
  @@index([businessId, paidAt])
  @@map("PaymentLink")
}

// ─────────────────────────────────────────────────────────────────────────────
// ApiKey — merchant API credentials
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  publicId    String      @unique
  businessId  String
  name        String
  environment Environment
  keyPrefix   String
  secretHash  String
  lastFour    String
  active      Boolean     @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())
  revokedAt   DateTime?

  @@index([businessId])
  @@index([keyPrefix, businessId])
  @@unique([businessId, environment, keyPrefix])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer — merchant-scoped customer identity
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  publicId              String    @unique
  businessId            String
  email                 String?
  name                  String?
  metadata              Json      @default("{}")
  paymentCount          Int       @default(0)
  lifetimeValue         String    @default("0.00")
  lifetimeValueCurrency String    @default("USDC")
  lastPaymentAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  payments Payment[]

  @@index([businessId])
  @@index([businessId, email])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment — canonical payment resource
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  publicId           String          @unique
  businessId         String
  environment        Environment
  status             PaymentStatus   @default(created)
  amount             String
  currency           PaymentCurrency
  description        String?
  customerId         String?         @db.ObjectId
  customer           Customer?       @relation(fields: [customerId], references: [id])
  metadata           Json            @default("{}")
  checkoutUrl        String
  paymentLinkId      String          @unique
  linkMemo           String          @unique
  destinationAddress String
  payerAddress       String?
  transactionHash    String?         @unique
  assetIssuer        String?
  failureCode        String?
  failureMessage     String?
  expiresAt          DateTime?
  paidAt             DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  events PaymentEvent[]

  @@index([businessId])
  @@index([businessId, environment, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
  @@map("payments")
}

model PaymentEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  publicId   String   @unique
  businessId String
  paymentId  String   @db.ObjectId
  payment    Payment  @relation(fields: [paymentId], references: [id])
  type       String
  data       Json
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([paymentId])
  @@unique([paymentId, type])
  @@map("payment_events")
}

model WebhookEndpoint {
  id                     String      @id @default(auto()) @map("_id") @db.ObjectId
  publicId               String      @unique
  businessId             String
  environment            Environment
  url                    String
  description            String?
  events                 String[]
  signingSecretEncrypted String
  secretLastFour         String
  active                 Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  disabledAt             DateTime?

  deliveries WebhookDelivery[]

  @@index([businessId])
  @@index([businessId, environment])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  publicId       String          @unique
  businessId     String
  endpointId     String          @db.ObjectId
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventId        String
  status         DeliveryStatus  @default(pending)
  attemptCount   Int             @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([businessId])
  @@index([endpointId])
  @@index([eventId])
  @@unique([endpointId, eventId])
  @@map("webhook_deliveries")
}

model IdempotencyRecord {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId     String
  apiKeyId       String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([businessId])
  @@index([apiKeyId])
  @@index([expiresAt])
  @@unique([businessId, apiKeyId, key])
  @@map("idempotency_records")
}
